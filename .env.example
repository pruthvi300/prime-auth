PROJECT_NAME=Prime Auth
API_V1_STR=/api/v1
ENVIRONMENT=development

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_THIS_TO_A_SECURE_SECRET_KEY
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

LOGIN_RATE_LIMIT=5/minute
REGISTER_RATE_LIMIT=10/hour

# Either set DATABASE_URL directly...
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/prime_auth
# ...or the individual parts:
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=prime_auth
POSTGRES_PORT=5432
